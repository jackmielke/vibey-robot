# Vibey robot secrets — copy to .env and fill in. .env is gitignored.

# ElevenLabs (voice + fast-mode conversational agent)
ELEVENLABS_API_KEY=sk_...
ELEVEN_VOICE_ID=EQC5zQOuq9t6MrkD0MPT
ELEVEN_AGENT_ID=agent_...

# OpenAI Realtime API (speech-to-speech "Realtime" mode)
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Robot daemon — changes per network; find via: arp -a | grep -i reachy
REACHY_URL=http://192.168.1.120:8000

# Supabase (face memory + shared journal)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=eyJ...

# --- Vibe check (reachy_vibe.py) --------------------------------------------
# Saving vibe scores to Supabase is OFF by default and stays off unless BOTH
# this is 1 AND the person says yes out loud on that particular check. Rows
# hold a salted hash, never a name. Set VIBE_LOG=0 to kill it entirely.
VIBE_LOG=0
# Optional: makes the anonymous ID stable across restarts. Unset = random per
# process, so rows group within a session and never across sessions.
# VIBE_ANON_SALT=

# Telegram bot — text Vibey from anywhere
TELEGRAM_BOT_TOKEN=...

# Voice chat listens through the robot's own mic (needs reachy_robot_mic.py).
# NOTE: this is the single biggest factor in transcription quality. The robot
# mic is far-field and hears the entire room — competing media, reverb, other
# people. Benchmarked, the same sentence scores ~5% WER on a close mic and
# fails completely through the robot mic. Set MIC_SOURCE=laptop when you're at
# the desk and want dictation-grade accuracy. (Launch the chat service from a
# real shell in that case, or macOS won't grant mic permission and it reads
# zeros.)
MIC_SOURCE=robot
ROBOT_MIC_URL=http://localhost:8775

# Noise suppression profile (reachy_denoise.py) — the starting one; saying
# "there's music playing" changes it mid-conversation and .audio_prefs.json
# remembers it after that, so this only matters on a machine that has never
# been told.
#   off        untouched
#   light      quiet room, gentle
#   robust     quiet room AND a quiet or distant talker (adds makeup gain)
#   on         normal room, adapts itself — the default
#   music      a track or a TV playing: non-speech is ducked hard, so a
#              backing track can't start a turn
#   aggressive loud or crowded — voice only
VIBEY_NOISE_SUPPRESSION=on

# Speech-to-text. small.en is near-perfect on clean audio and much faster than
# medium.en, which is only worth it on a close-talking mic. Neither can rescue
# degraded far-field audio — fix the mic, not the model.
WHISPER_MODEL=small.en
WHISPER_BEAM=5
WHISPER_VAD=1

# --- Self-improvement (reachy_agent.py) -------------------------------------
# The "improve_yourself" voice tool shells out to the Claude CLI with this repo
# as the working directory, so Vibey can edit their own source mid-conversation.
# acceptEdits = may write files, still gates shell commands.
# bypassPermissions = full autonomy (what you want for unattended overnight runs).
AGENT_PERMISSION_MODE=acceptEdits
AGENT_MODEL=claude-opus-5
AGENT_TIMEOUT=900
# CLAUDE_BIN=/Users/you/.local/bin/claude   # only if `which claude` fails

# Start on the OpenAI Realtime brain (default). Set to 0 for the Claude CLI brain.
OPENAI_MODE=1

# Put itself to bed after this many seconds of nobody talking (default 900).
VIBEY_IDLE_SLEEP_S=1800
