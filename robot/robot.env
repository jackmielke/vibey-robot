# Robot-side overrides, loaded by every vibey-*.service (EnvironmentFile=).
# NO SECRETS HERE: this file is in git. Keys come from ~/vibey/app/.env, which
# the services read themselves (reachy_voice.load_env). That loader never
# overwrites a variable already set, so everything below wins over the Mac's
# .env: REACHY_URL in particular must be localhost here, not the robot's LAN IP.

VIBEY_ON_ROBOT=1

# The daemon is on this board.
REACHY_URL=http://localhost:8000
REACHY_HOST=localhost

# Mic: the bridge reads the daemon's LOCAL audio and serves it on loopback only.
ROBOT_MIC_URL=http://localhost:8775
ROBOT_MIC_BIND=127.0.0.1
MIC_SOURCE=robot
SPEAKER_SOURCE=robot

# Camera: every frame is a software JPEG encode on the CM4. Keep it low.
CAMERA_MAX_FPS=4

# Control-loop guard in reachy_watchdog.py.
VIBEY_LOOP_MIN_HZ=40

PYTHONUNBUFFERED=1
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
