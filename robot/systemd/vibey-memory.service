# Vibey on the robot: face memory on :8773. LAST phase: needs a face model that fits the CM4
# Installed by robot/install.sh into ~/.config/systemd/user/. Niced below the
# Pollen daemon and CPU-capped so the motor control loop stays at 40Hz or more.
# CPUQuota is per core (the CM4 has 4, so 400% is the whole board).
[Unit]
Description=Vibey memory: face memory on :8773. LAST phase: needs a face model that fits the CM4
PartOf=vibey.target
After=network-online.target
Wants=vibey-camera.service
After=vibey-camera.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/vibey/app
EnvironmentFile=%h/vibey/app/robot/robot.env
Environment=VIBEY_MEMORIES_DIR=%h/vibey/memories
ExecStart=%h/vibey/bin/sdk-python -u reachy_memory.py
Restart=always
RestartSec=5
Nice=10
CPUWeight=20
CPUQuota=50%
MemoryHigh=595M
MemoryMax=700M
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=vibey.target
