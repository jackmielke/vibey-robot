# Vibey on the robot: health checks through systemctl, plus the control-loop guard (<40Hz alerts)
# Installed by robot/install.sh into ~/.config/systemd/user/. Niced below the
# Pollen daemon and CPU-capped so the motor control loop stays at 40Hz or more.
# CPUQuota is per core (the CM4 has 4, so 400% is the whole board).
[Unit]
Description=Vibey watchdog: health checks through systemctl, plus the control-loop guard (<40Hz alerts)
PartOf=vibey.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/vibey/app
EnvironmentFile=%h/vibey/app/robot/robot.env
Environment=VIBEY_MEMORIES_DIR=%h/vibey/memories
ExecStart=%h/vibey/.venv/bin/python -u reachy_watchdog.py
Restart=always
RestartSec=5
Nice=10
CPUWeight=20
CPUQuota=5%
MemoryHigh=85M
MemoryMax=100M
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=vibey.target
